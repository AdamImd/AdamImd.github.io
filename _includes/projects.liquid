<article class="project-tile" data-project-card>
  <a class="project-tile-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <div class="project-tile-image">
    {% if project.img %}
      {% include figure.liquid loading="lazy" path=project.img sizes="(min-width: 1100px) 330px, (min-width: 700px) 45vw, 95vw" alt=project.title %}
    {% else %}
      <span class="project-placeholder" aria-hidden="true"><i class="{{ project.icon | default: 'fa-solid fa-flask' }}"></i></span>
    {% endif %}
    </div>
    <div class="project-tile-body">
      {% if project.stage %}<span class="project-stage">{{ project.stage }}</span>{% endif %}
      <h3>{{ project.title }}</h3>
      <p>{{ project.description }}</p>
      <span class="project-read-more">Explore project <span aria-hidden="true">↗</span></span>
    </div>
  </a>
  {% if project.github %}<a class="project-code-link" href="{{ project.github }}" aria-label="Code for {{ project.title | escape }}">Code on GitHub</a>{% endif %}
</article>
