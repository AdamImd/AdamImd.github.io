{% assign media = include.media %}
<figure class="spotrl-video" id="{{ media.id }}">
  <div class="spotrl-video-frame">
    <video
      controls
      playsinline
      preload="none"
      width="{{ media.width }}"
      height="{{ media.height }}"
      poster="{{ 'assets/img/projects/spot-whole-body/' | append: media.file | append: '.jpg' | relative_url }}"
      aria-label="{{ media.title | escape }}"
    >
      <source src="{{ 'assets/video/projects/spot-whole-body/' | append: media.file | append: '.mp4' | relative_url }}" type="video/mp4">
      <track
        kind="captions"
        src="{{ 'assets/video/projects/spot-whole-body/' | append: media.file | append: '.vtt' | relative_url }}"
        srclang="en"
        label="English descriptions"
      >
      Your browser does not support video playback. Use the MP4 download below.
    </video>
  </div>
  <figcaption>
    <p>{{ media.caption }}</p>
    <div class="spotrl-video-meta">
      <span>{{ media.duration }} · Silent · {{ media.note }}</span
      ><a href="{{ 'assets/video/projects/spot-whole-body/' | append: media.file | append: '.mp4' | relative_url }}" download
        >Download MP4 <span aria-hidden="true">↗</span></a
      >
    </div>
    <details class="spotrl-description">
      <summary>Visual description</summary>
      <p>{{ media.transcript }}</p>
    </details>
  </figcaption>
</figure>
