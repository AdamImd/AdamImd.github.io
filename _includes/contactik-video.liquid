{% assign media = include.media %}
<figure class="contactik-video" id="{{ media.id }}">
  <div class="contactik-video-frame">
    <video
      controls
      playsinline
      preload="none"
      width="1920"
      height="1080"
      poster="{{ 'assets/img/projects/contactik/' | append: media.file | append: '.jpg' | relative_url }}"
      aria-label="{{ media.title | escape }}"
    >
      <source src="{{ 'assets/video/projects/contactik/' | append: media.file | append: '.mp4' | relative_url }}" type="video/mp4">
      <track
        kind="captions"
        src="{{ 'assets/video/projects/contactik/' | append: media.file | append: '.vtt' | relative_url }}"
        srclang="en"
        label="English descriptions"
      >
      Your browser does not support video playback. Use the MP4 download below.
    </video>
  </div>
  <figcaption>
    <p>{{ media.caption }}</p>
    <div class="contactik-video-links">
      <span>Silent, annotated · 1080p</span
      ><a href="{{ 'assets/video/projects/contactik/' | append: media.file | append: '.mp4' | relative_url }}" download
        >Download MP4 <span aria-hidden="true">↗</span></a
      >
    </div>
    <details class="contactik-transcript">
      <summary>Visual description</summary>
      <p>{{ media.transcript }}</p>
    </details>
  </figcaption>
</figure>
